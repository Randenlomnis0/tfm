<?xml version="1.0"?>

<launch>
  <!-- ================================================================ -->
  <!-- Static TF                                                        -->
  <!-- ================================================================ -->

  <node
      pkg="tf2_ros"
      exec="static_transform_publisher"
      name="base_link_to_lidar3d_0"
      output="screen"
      args="
        --x -0.15
        --y 0.0
        --z 0.304
        --roll 0.0
        --pitch 0.0
        --yaw 3.1415
        --frame-id base_link
        --child-frame-id lidar3d_0"/>
  
  <node
    pkg="tf2_ros"
    exec="static_transform_publisher"
    name="base_link_to_camera_link"
    output="screen"
    args="
      --x 0.25
      --y 0.0
      --z 0.20
      --roll 0.0
      --pitch 0.0
      --yaw 0.0
      --frame-id base_link
      --child-frame-id j100_0562/D435_1/D435_1_link"/>

  <!-- ================================================================ -->
  <!-- Livox                                                            -->
  <!-- ================================================================ -->

  <node
      pkg="livox_ros_driver2"
      exec="livox_ros_driver2_node"
      name="livox_lidar_publisher"
      output="screen">

    <param name="xfer_format" value="0"/>
    <param name="multi_topic" value="0"/>
    <param name="data_src" value="0"/>
    <param name="publish_freq" value="10.0"/>
    <param name="output_data_type" value="0"/>
    <param name="frame_id" value="lidar3d_0"/>
    <param name="user_config_path" value="$(find-pkg-share livox_ros_driver2)/config/MID360_config.json"/>
    <param name="cmdline_input_bd_code" value="livox0000000001"/>

    <remap from="livox/points" to="/livox/points"/>
    <remap from="livox/imu" to="/livox/imu"/>
  </node>

  <!-- ================================================================ -->
  <!-- Realsense                                                        -->
  <!-- ================================================================ -->

  <include
      file="$(find-pkg-share realsense2_camera)/launch/rs_launch.py">

      <arg name="camera_namespace" value="j100_0562"/>
      <arg name="camera_name" value="D435_1"/>
      <arg name="tf_prefix" value="j100_0562/D435_1/"/>
      <arg name="enable_rgbd" value="true"/>
      <arg name="align_depth.enable" value="true"/>
      <arg name="enable_sync" value="true"/>
      <arg name="rgb_camera.color_profile" value="640x360x15"/>
      <arg name="depth_module.depth_profile" value="640x360x15"/>
  </include>

  <!-- ================================================================ -->
  <!-- PointCloud -> LaserScan                                          -->
  <!-- ================================================================ -->

  <node
      pkg="pointcloud_to_laserscan"
      exec="pointcloud_to_laserscan_node"
      name="pointcloud_to_laserscan"
      output="screen">

    <param name="use_sim_time" value="false"/>
    <param name="target_frame" value="lidar3d_0"/>
    <param name="transform_tolerance" value="0.3"/>
    <param name="min_height" value="0.25"/>
    <param name="max_height" value="0.4"/>
    <param name="angle_min" value="-3.14159265"/>
    <param name="angle_max" value="3.14159265"/>
    <param name="angle_increment" value="0.00872665"/>
    <param name="scan_time" value="0.1"/>
    <param name="range_min" value="0.5"/>
    <param name="range_max" value="50.0"/>
    <param name="use_inf" value="true"/>
    <param name="inf_epsilon" value="1.0"/>

    <remap from="cloud_in" to="/livox/points"/>
    <remap from="scan" to="/scan"/>
  </node>

  <!-- ================================================================ -->
  <!-- Laser Scan Matcher                                               -->
  <!-- ================================================================ -->

  <timer period="4.0">
    <node
        pkg="ros2_laser_scan_matcher"
        exec="laser_scan_matcher"
        name="laser_scan_matcher"
        output="screen">

      <param name="base_frame" value="base_link"/>
      <param name="laser_frame" value="lidar3d_0"/>
      <param name="odom_frame" value="odom"/>
      <param name="map_frame" value="map"/>
      <param name="publish_tf" value="true"/>
      <param name="publish_odom" value="/odom"/>
    </node>
  </timer>

  <!-- ================================================================ -->
  <!-- SLAM                                                             -->
  <!-- ================================================================ -->

  <timer period="10.0">
    <include
        file="$(find-pkg-share tfm)/launch/tfm_slam.launch.py">

      <arg name="use_sim_time" value="false"/>
      <arg name="sync" value="false"/>
      <arg name="slam_params" value="tfm_slam_real.yaml"/>
    </include>
  </timer>

  <!-- ================================================================ -->
  <!-- Nav2                                                             -->
  <!-- ================================================================ -->

  <timer period="20.0">
    <include
        file="$(find-pkg-share tfm)/launch/tfm_nav2.launch.py">

      <arg name="use_sim_time" value="false"/>
      <arg name="nav2_params" value="tfm_nav2_real.yaml"/>
    </include>

    <!-- <node
        pkg="rviz2"
        exec="rviz2"
        name="rviz2_tfm"
        output="screen"
        args="-d $(find-pkg-share tfm)/config/tfm_config.rviz">

      <param name="use_sim_time" value="false"/>
    </node> -->
  </timer>
</launch>